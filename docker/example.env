JAVA_OPTS=-Xmx200m
# ── AI (OpenAI-совместимый API) ──
AI_BASE_URL=https://api.openai.com/
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=deepseek-v4-flash

# ── Embedding (OpenAI-совместимый API - 1024 dimension) ──
AI_EMBED_BASE_URL=https://api.openai.com/
AI_EMBED_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AI_EMBED_MODEL=bge-m3

# ── Database ──
DATASOURCE_URL=jdbc:postgresql://postgres:5432/knowledgebase
DATASOURCE_USERNAME=knowledgebase
DATASOURCE_PASSWORD=knowledgebase

# ── Project ──
# Абсолютный путь к репозиторию на хосте.
PROJECT_PATH_MOUNT=
DOCUMENTS_EXPORT_PATH=

# ── Второй проект (по умолчанию выключен) ──
# Включается тремя шагами: PROJECT2_ENABLED=true, путь на хосте в PROJECT2_PATH_MOUNT и
# раскомментированный mount в docker-compose*.yaml. id попадает в адреса как есть.
# PROJECT2_ENABLED=true
# PROJECT2_PATH_MOUNT=
# PROJECT2_ID=billing
# PROJECT2_LABEL=Billing
# PROJECT2_PATH=/projects/billing
# PROJECT2_EDIT_ENABLED=false
